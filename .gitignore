# Laravel
/vendor
/node_modules
/.env
/.env.*
!/.env.example
/storage/*.key
/public/hot
/public/storage
# El servidor de producción (Hostinger) no tiene Node/npm disponible por SSH,
# así que el build compilado SÍ se versiona (a diferencia del default de
# Laravel) — es la única forma de llevarlo a public_html sin poder compilar
# ahí. Cada vez que cambie resources/css o resources/js hay que correr
# `npm run build` en local y comitear lo que cambie en public/build.
/bootstrap/cache/*.php
/storage/app/*
!/storage/app/public
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
